# ==============================================================================
# BERMUDA PORTAL - HOSTLESS CLOUD GATEWAY ENVIRONMENT TEMPLATE
# Platform: Hostless Cloud (Hetzner Helsinki fi-hel1) + Cloudflare Edge
# Baseline: 0.5 vCPU / 1024 MB RAM (Always-On Free Tier · Never Sleeps)
# Usage: Import directly into Hostless Dashboard -> App -> Environment Variables
# ==============================================================================

# [Recommended for Edge Tuning & Multi-Port] Cloudflare API Token (Zone/DNS/Ruleset Edit)
# Note: In Cloudflare Token creation, set Zone Resources -> Include -> Specific zone -> your domain
CLOUDFLARE_API_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Auto-discovered if left empty)
CLOUDFLARE_ZONE_ID=

# [Recommended for Auto-Provisioning] Hostless Scoped API Key (starts with hlk_...)
# Direct Path: Account -> Settings -> API Keys (Select apps:read, apps:write, deployments:read, deployments:write)
HOSTLESS_API_KEY=

# [Optional] Explicit Hostless Application Name (Auto-discovered via API Key if left empty)
HOSTLESS_APP_NAME=

# [Recommended] Custom Domain routed through Cloudflare Edge (e.g. portal.yourdomain.dpdns.org)
CUSTOM_DOMAIN=

# [Optional] Default Hostless App Subdomain (e.g. my-app.hostless.app)
# Auto-discovered via HOSTLESS_API_KEY or first HTTP request if left empty
HOSTLESS_DOMAIN=

# [Recommended] Master Secret Seed for Deterministic Key Derivation (e.g. bmk-...)
# Pre-filled by the Bermuda Portal Wizard or silently persisted via API (deploy: false)
BERMUDA_MASTER_KEY=

# [Optional] Deployment Region Identifier (Default: fi-hel1 for Hetzner Helsinki AS24940)
# Supported: fi-hel1, de-fra1, europe-west4, ch-central, uk-lon1, us-east4, us-west, asia-southeast1
BERMUDA_REGION=fi-hel1
